{
  "name": "lexiquest",
  "version": "1.0.0",
  "description": "LexiQuest vocabulary learning app",
  "scripts": {
    "copy:web": "node scripts/copy-to-www.js",
    "copy:fonts": "node scripts/copy-fonts.js",
    "parse:words": "python scripts/parse-word-lists-pdf.py",
    "enrich:examples": "node scripts/enrich-examples.js",
    "seed:dictionary": "node scripts/seed-dictionary-list.js",
    "expand:dictionary": "node scripts/expand-dictionary-lists.js",
    "cms:export": "node scripts/cms-export-csv.js",
    "cms:import": "node scripts/cms-import-csv.js",
    "smoke": "node scripts/smoke-test.js",
    "enrich:content": "npm run enrich:definitions && npm run enrich:examples",
    "prepare:web": "npm run copy:web && npm run copy:fonts",
    "assets:android": "npx capacitor-assets generate --iconBackgroundColor \"#0D0D0D\" --splashBackgroundColor \"#0D0D0D\" --android",
    "cap:sync": "npm run prepare:web && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "android:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "tutor:api": "node scripts/tutor-api-example.mjs",
    "dev": "npx --yes serve . -l 3456"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.1",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/syne": "^5.2.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0"
  }
}
